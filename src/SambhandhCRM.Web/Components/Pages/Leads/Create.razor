@page "/leads/create"
@page "/leads/edit/{id:long}"
@using SambhandhCRM.Core.Models
@using SambhandhCRM.Core.Models.Enums
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>@(IsEdit ? "Edit Lead" : "Create New Lead") - Sambandh CRM</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h2>@(IsEdit ? "Edit Lead" : "Create New Lead")</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/leads">Leads</a></li>
                    <li class="breadcrumb-item active">@(IsEdit ? "Edit" : "Create")</li>
                </ol>
            </nav>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <EditForm Model="lead" OnValidSubmit="HandleSubmit">
            <!-- Lead Details -->
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Lead Information</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @if (IsEdit)
                        {
                            <div class="col-md-4">
                                <label class="form-label">Lead ID</label>
                                <input type="text" class="form-control" value="@lead.LeadNumber" readonly />
                            </div>
                        }

                        <div class="col-md-@(IsEdit ? "8" : "12")">
                            <label class="form-label">Customer <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="lead.PartyId" required>
                                <option value="">Select Customer...</option>
                                @if (customers != null)
                                {
                                    @foreach (var customer in customers)
                                    {
                                        <option value="@customer.Id">@customer.EntityName</option>
                                    }
                                }
                            </select>
                            <small class="text-muted">
                                Don't see the customer? <a href="/customers/create" target="_blank">Add new customer</a>
                            </small>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Lead Source <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="lead.LeadSource" required>
                                <option value="">Select...</option>
                                <option value="Direct Walk-in">Direct Walk-in</option>
                                <option value="Website">Website</option>
                                <option value="Referral - Customer">Referral - Customer</option>
                                <option value="Referral - Employee">Referral - Employee</option>
                                <option value="Campaign">Campaign</option>
                                <option value="Others">Others</option>
                            </select>
                        </div>

                        @if (lead.LeadSource == "Referral - Customer" || lead.LeadSource == "Referral - Employee")
                        {
                            <div class="col-md-4">
                                <label class="form-label">Referral Source</label>
                                <input type="text" class="form-control" @bind="lead.ReferralSource" placeholder="Name of referrer" />
                            </div>
                        }

                        <div class="col-md-4">
                            <label class="form-label">Product Interest <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="lead.ProductInterest" required>
                                <option value="">Select...</option>
                                <option value="Term Loan">Term Loan</option>
                                <option value="Working Capital">Working Capital</option>
                                <option value="Guarantee">Guarantee</option>
                                <option value="Others">Others</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Loan Amount Range</label>
                            <select class="form-select" @bind="lead.LoanAmountRange">
                                <option value="">Select...</option>
                                <option value="&lt; 10L">&lt; 10 Lakhs</option>
                                <option value="10L - 50L">10L - 50L</option>
                                <option value="50L - 1Cr">50L - 1 Crore</option>
                                <option value="1Cr - 5Cr">1 Crore - 5 Crores</option>
                                <option value="&gt; 5Cr">&gt; 5 Crores</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Priority</label>
                            <select class="form-select" @bind="lead.Priority">
                                @foreach (var priority in Enum.GetValues<Priority>())
                                {
                                    <option value="@priority">@priority</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Status</label>
                            <select class="form-select" @bind="lead.Status">
                                @foreach (var status in Enum.GetValues<LeadStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Activity Tracking -->
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Activity Tracking</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Last Contact Date</label>
                            <input type="date" class="form-control" @bind="lead.LastContactDate" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Next Follow-up Date</label>
                            <input type="date" class="form-control" @bind="lead.NextFollowUpDate" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Notes/Comments</label>
                            <textarea class="form-control" @bind="lead.Notes" rows="4"
                                      placeholder="Add any relevant notes or comments..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Document Checklist -->
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Document Checklist</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="lead.IsKYCReceived" id="kycDocs" />
                                <label class="form-check-label" for="kycDocs">
                                    KYC Documents
                                </label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="lead.IsFinancialStatementsReceived" id="financialDocs" />
                                <label class="form-check-label" for="financialDocs">
                                    Financial Statements
                                </label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="lead.IsBusinessDocumentsReceived" id="businessDocs" />
                                <label class="form-check-label" for="businessDocs">
                                    Business Documents
                                </label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="lead.IsOtherDocumentsReceived" id="otherDocs" />
                                <label class="form-check-label" for="otherDocs">
                                    Other Documents
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (lead.Status == LeadStatus.Dropped)
            {
                <!-- Drop Reason -->
                <div class="card mb-3">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">Drop Reason</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label">Reason for Dropping <span class="text-danger">*</span></label>
                                <textarea class="form-control" @bind="lead.DropReason" rows="3" required></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Form Actions -->
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary" @onclick="Cancel">
                            <i class="bi bi-x-circle"></i> Cancel
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@saving">
                            @if (saving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <i class="bi bi-save"></i> @(IsEdit ? "Update" : "Save") Lead
                        </button>
                    </div>
                </div>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public long? Id { get; set; }

    private Lead lead = new();
    private List<Customer>? customers;
    private bool loading = false;
    private bool saving = false;

    private bool IsEdit => Id.HasValue && Id.Value != 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();

        if (IsEdit)
        {
            await LoadLead();
        }
        else
        {
            lead = new Lead
            {
                Id = 0,
                LeadNumber = GenerateLeadNumber(),
                CreatedDate = DateTime.UtcNow,
                Priority = "Medium",
                Status = "New"
            };

            // Check for customerId in query string
            var uri = new Uri(Navigation.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            if (long.TryParse(query["customerId"], out var customerId))
            {
                lead.PartyId = customerId;
            }
        }
    }

    private async Task LoadCustomers()
    {
        try
        {
            // Mock data - replace with actual API call
            customers = new List<Customer>();
            // customers = await Http.GetFromJsonAsync<List<Customer>>("/api/customers");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customers: {ex.Message}");
            customers = new List<Customer>();
        }
    }

    private async Task LoadLead()
    {
        loading = true;
        try
        {
            // Mock data - replace with actual API call
            // lead = await Http.GetFromJsonAsync<Lead>($"/api/leads/{Id}");
            lead = new Lead { Id = Id!.Value };
        }
        finally
        {
            loading = false;
        }
    }

    private async Task HandleSubmit()
    {
        saving = true;
        try
        {
            // Mock save - replace with actual API call
            // if (IsEdit)
            // {
            //     await Http.PutAsJsonAsync($"/api/leads/{Id}", lead);
            // }
            // else
            // {
            //     await Http.PostAsJsonAsync("/api/leads", lead);
            // }

            await Task.Delay(500); // Simulate API call
            Navigation.NavigateTo("/leads");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving lead: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/leads");
    }

    private string GenerateLeadNumber()
    {
        var now = DateTime.UtcNow;
        return $"LEAD-{now:yyyyMM}-{new Random().Next(1000, 9999)}";
    }
}
