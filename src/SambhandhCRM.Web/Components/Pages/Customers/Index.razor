@page "/customers"
@using SambhandhCRM.Core.Models
@using SambhandhCRM.Core.Models.Enums
@using SambhandhCRM.Core.Repositories.Interfaces
@inject ICustomerRepository CustomerRepository
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Customer Database - Sambandh CRM</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h2>Customer Database (Party Master)</h2>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="NavigateToCreate">
                <i class="bi bi-plus-circle"></i> Add New Customer
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Search</label>
                    <input type="text" class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Name, PAN, Mobile..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Legal Constitution</label>
                    <select class="form-select" @bind="filterLegalConstitution">
                        <option value="">All</option>
                        @foreach (var type in Enum.GetValues<LegalConstitution>())
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Status</label>
                    <select class="form-select" @bind="filterStatus">
                        <option value="">All</option>
                        @foreach (var status in Enum.GetValues<CustomerStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Business Segment</label>
                    <input type="text" class="form-control" @bind="filterSegment" placeholder="FPO, MFI, etc." />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-secondary w-100" @onclick="ClearFilters">
                        <i class="bi bi-x-circle"></i> Clear
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Customer List -->
    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (customers == null || !customers.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No customers found. Click "Add New Customer" to get started.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Entity Name</th>
                                <th>Legal Constitution</th>
                                <th>PAN</th>
                                <th>Contact</th>
                                <th>Status</th>
                                <th>Business Segment</th>
                                <th>Created Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in filteredCustomers)
                            {
                                <tr>
                                    <td>
                                        <strong>@customer.EntityName</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@customer.LegalConstitution</span>
                                    </td>
                                    <td>@customer.PANNumber</td>
                                    <td>
                                        <div>@customer.PrimaryPhone</div>
                                        <small class="text-muted">@customer.PrimaryEmail</small>
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(customer.Status)">
                                            @customer.Status
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(customer.BusinessSegment))
                                        {
                                            <span>@customer.BusinessSegment</span>
                                        }
                                    </td>
                                    <td>@customer.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary" @onclick="() => ViewCustomer(customer.Id)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button class="btn btn-outline-secondary" @onclick="() => EditCustomer(customer.Id)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Info -->
                <div class="mt-3">
                    <small class="text-muted">
                        Showing @filteredCustomers.Count() of @customers.Count() customers
                    </small>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Customer>? customers;
    private bool loading = true;
    private string searchTerm = "";
    private string filterLegalConstitution = "";
    private string filterStatus = "";
    private string filterSegment = "";

    private IEnumerable<Customer> filteredCustomers =>
        customers?.Where(c =>
            (string.IsNullOrEmpty(searchTerm) ||
             c.EntityName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             (c.PANNumber != null && c.PANNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
             (c.PrimaryPhone != null && c.PrimaryPhone.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))) &&
            (string.IsNullOrEmpty(filterLegalConstitution) || c.LegalConstitution.ToString() == filterLegalConstitution) &&
            (string.IsNullOrEmpty(filterStatus) || c.Status.ToString() == filterStatus) &&
            (string.IsNullOrEmpty(filterSegment) ||
             (c.BusinessSegment != null && c.BusinessSegment.Contains(filterSegment, StringComparison.OrdinalIgnoreCase)))
        ) ?? Enumerable.Empty<Customer>();

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        loading = true;
        try
        {
            var result = await CustomerRepository.GetAllAsync();
            customers = result.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customers: {ex.Message}");
            customers = new List<Customer>();
        }
        finally
        {
            loading = false;
        }
    }

    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/customers/create");
    }

    private void ViewCustomer(long id)
    {
        Navigation.NavigateTo($"/customers/{id}");
    }

    private void EditCustomer(long id)
    {
        Navigation.NavigateTo($"/customers/edit/{id}");
    }

    private void ClearFilters()
    {
        searchTerm = "";
        filterLegalConstitution = "";
        filterStatus = "";
        filterSegment = "";
    }

    private string GetStatusBadgeClass(CustomerStatus status)
    {
        return status switch
        {
            CustomerStatus.Prospect => "bg-secondary",
            CustomerStatus.ActiveLead => "bg-warning",
            CustomerStatus.Customer => "bg-success",
            CustomerStatus.Dormant => "bg-info",
            CustomerStatus.Archived => "bg-dark",
            _ => "bg-secondary"
        };
    }
}
