@page "/communications"
@using SambhandhCRM.Core.Models
@using SambhandhCRM.Core.Models.Enums
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Communication Log - Sambandh CRM</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h2>Communication Log</h2>
            <p class="text-muted">Track all customer interactions</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="NavigateToCreate">
                <i class="bi bi-plus-circle"></i> Log Communication
            </button>
            <button class="btn btn-outline-primary" @onclick="NavigateToCampaigns">
                <i class="bi bi-megaphone"></i> Campaigns
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Search</label>
                    <input type="text" class="form-control" @bind="searchTerm" @bind:event="oninput"
                           placeholder="Customer, subject..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Type</label>
                    <select class="form-select" @bind="filterType">
                        <option value="">All</option>
                        @foreach (var type in Enum.GetValues<CommunicationType>())
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Direction</label>
                    <select class="form-select" @bind="filterDirection">
                        <option value="">All</option>
                        @foreach (var direction in Enum.GetValues<CommunicationDirection>())
                        {
                            <option value="@direction">@direction</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">From Date</label>
                    <input type="date" class="form-control" @bind="filterFromDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">To Date</label>
                    <input type="date" class="form-control" @bind="filterToDate" />
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button class="btn btn-secondary w-100" @onclick="ClearFilters">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Communication List -->
    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (communications == null || !communications.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No communications logged. Click "Log Communication" to get started.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Date & Time</th>
                                <th>Customer</th>
                                <th>Type</th>
                                <th>Direction</th>
                                <th>Subject</th>
                                <th>Summary</th>
                                <th>Logged By</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var comm in filteredCommunications)
                            {
                                <tr>
                                    <td>
                                        <div>@comm.CommunicationDate.ToString("dd MMM yyyy")</div>
                                        <small class="text-muted">@comm.CommunicationDate.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>
                                        <strong>@comm.Customer?.EntityName</strong>
                                        @if (comm.Lead != null)
                                        {
                                            <br /><small class="text-muted">@comm.Lead.LeadNumber</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @GetTypeBadgeClass(comm.CommunicationType)">
                                            @GetTypeIcon(comm.CommunicationType) @comm.CommunicationType
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @GetDirectionBadgeClass(comm.Direction)">
                                            @(comm.Direction == CommunicationDirection.Inbound ? "↓" : "↑") @comm.Direction
                                        </span>
                                    </td>
                                    <td>@comm.Subject</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(comm.Summary))
                                        {
                                            <span>@(comm.Summary.Length > 50 ? comm.Summary.Substring(0, 50) + "..." : comm.Summary)</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@comm.CreatedBy</small>
                                    </td>
                                    <td>
                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => ViewCommunication(comm.Id)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Info -->
                <div class="mt-3">
                    <small class="text-muted">
                        Showing @filteredCommunications.Count() of @communications.Count() communications
                    </small>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<CommunicationLog>? communications;
    private bool loading = true;
    private string searchTerm = "";
    private string filterType = "";
    private string filterDirection = "";
    private DateTime? filterFromDate;
    private DateTime? filterToDate;

    private IEnumerable<CommunicationLog> filteredCommunications =>
        communications?.Where(c =>
            (string.IsNullOrEmpty(searchTerm) ||
             (c.Customer?.EntityName != null && c.Customer.EntityName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
             c.Subject.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(filterType) || c.CommunicationType.ToString() == filterType) &&
            (string.IsNullOrEmpty(filterDirection) || c.Direction.ToString() == filterDirection) &&
            (!filterFromDate.HasValue || c.CommunicationDate.Date >= filterFromDate.Value.Date) &&
            (!filterToDate.HasValue || c.CommunicationDate.Date <= filterToDate.Value.Date)
        ) ?? Enumerable.Empty<CommunicationLog>();

    protected override async Task OnInitializedAsync()
    {
        await LoadCommunications();
    }

    private async Task LoadCommunications()
    {
        loading = true;
        try
        {
            // Mock data - replace with actual API call
            communications = new List<CommunicationLog>();
            // communications = await Http.GetFromJsonAsync<List<CommunicationLog>>("/api/communications");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading communications: {ex.Message}");
            communications = new List<CommunicationLog>();
        }
        finally
        {
            loading = false;
        }
    }

    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/communications/create");
    }

    private void NavigateToCampaigns()
    {
        Navigation.NavigateTo("/communications/campaigns");
    }

    private void ViewCommunication(long id)
    {
        Navigation.NavigateTo($"/communications/{id}");
    }

    private void ClearFilters()
    {
        searchTerm = "";
        filterType = "";
        filterDirection = "";
        filterFromDate = null;
        filterToDate = null;
    }

    private string GetTypeBadgeClass(CommunicationType type)
    {
        return type switch
        {
            CommunicationType.PhoneCall => "bg-primary",
            CommunicationType.Email => "bg-info",
            CommunicationType.Meeting => "bg-success",
            CommunicationType.SiteVisit => "bg-warning",
            CommunicationType.WhatsApp => "bg-success",
            CommunicationType.SMS => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private string GetTypeIcon(CommunicationType type)
    {
        return type switch
        {
            CommunicationType.PhoneCall => "📞",
            CommunicationType.Email => "📧",
            CommunicationType.Meeting => "🤝",
            CommunicationType.SiteVisit => "🏢",
            CommunicationType.WhatsApp => "💬",
            CommunicationType.SMS => "📱",
            _ => "📋"
        };
    }

    private string GetDirectionBadgeClass(CommunicationDirection direction)
    {
        return direction == CommunicationDirection.Inbound ? "bg-info" : "bg-primary";
    }
}
