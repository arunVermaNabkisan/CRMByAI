@page "/admin"
@using SambhandhCRM.Core.Models
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>System Administration - Sambandh CRM</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h2>System Administration</h2>
            <p class="text-muted">Manage system settings and master data</p>
        </div>
    </div>

    <!-- Master Data Configuration -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-database"></i> Master Data Configuration</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card h-100 border-primary">
                        <div class="card-body">
                            <h6 class="card-title">Business Segments</h6>
                            <p class="card-text">Manage business segment categories</p>
                            <button class="btn btn-primary btn-sm" @onclick='() => NavigateTo("/admin/business-segments")'>
                                <i class="bi bi-gear"></i> Configure
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-primary">
                        <div class="card-body">
                            <h6 class="card-title">Product Categories</h6>
                            <p class="card-text">Manage product offerings</p>
                            <button class="btn btn-primary btn-sm" @onclick='() => NavigateTo("/admin/products")'>
                                <i class="bi bi-gear"></i> Configure
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-primary">
                        <div class="card-body">
                            <h6 class="card-title">Lead Sources</h6>
                            <p class="card-text">Configure lead source options</p>
                            <button class="btn btn-primary btn-sm" @onclick='() => NavigateTo("/admin/lead-sources")'>
                                <i class="bi bi-gear"></i> Configure
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-primary">
                        <div class="card-body">
                            <h6 class="card-title">Communication Types</h6>
                            <p class="card-text">Manage communication categories</p>
                            <button class="btn btn-primary btn-sm" @onclick='() => NavigateTo("/admin/communication-types")'>
                                <i class="bi bi-gear"></i> Configure
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-primary">
                        <div class="card-body">
                            <h6 class="card-title">Document Types</h6>
                            <p class="card-text">Configure document categories</p>
                            <button class="btn btn-primary btn-sm" @onclick='() => NavigateTo("/admin/document-types")'>
                                <i class="bi bi-gear"></i> Configure
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-primary">
                        <div class="card-body">
                            <h6 class="card-title">Drop/Rejection Reasons</h6>
                            <p class="card-text">Manage rejection reasons</p>
                            <button class="btn btn-primary btn-sm" @onclick='() => NavigateTo("/admin/rejection-reasons")'>
                                <i class="bi bi-gear"></i> Configure
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- System Settings -->
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0"><i class="bi bi-gear"></i> System Settings</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card h-100 border-secondary">
                        <div class="card-body">
                            <h6 class="card-title">Company Information</h6>
                            <p class="card-text">Update organization details</p>
                            <button class="btn btn-secondary btn-sm" @onclick='() => NavigateTo("/admin/company-info")'>
                                <i class="bi bi-building"></i> Configure
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-secondary">
                        <div class="card-body">
                            <h6 class="card-title">Email Configuration</h6>
                            <p class="card-text">SMTP and email settings</p>
                            <button class="btn btn-secondary btn-sm" @onclick='() => NavigateTo("/admin/email-config")'>
                                <i class="bi bi-envelope-gear"></i> Configure
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-secondary">
                        <div class="card-body">
                            <h6 class="card-title">SMS Gateway Settings</h6>
                            <p class="card-text">Configure SMS provider</p>
                            <button class="btn btn-secondary btn-sm" @onclick='() => NavigateTo("/admin/sms-config")'>
                                <i class="bi bi-phone"></i> Configure
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-secondary">
                        <div class="card-body">
                            <h6 class="card-title">Security Settings</h6>
                            <p class="card-text">Password policy and session timeout</p>
                            <button class="btn btn-secondary btn-sm" @onclick='() => NavigateTo("/admin/security")'>
                                <i class="bi bi-shield-lock"></i> Configure
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Management -->
    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-database-gear"></i> Data Management</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card h-100 border-info">
                        <div class="card-body">
                            <h6 class="card-title">Bulk Import</h6>
                            <p class="card-text">Import data from Excel files</p>
                            <button class="btn btn-info btn-sm" @onclick='() => NavigateTo("/admin/import")'>
                                <i class="bi bi-upload"></i> Import Data
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-info">
                        <div class="card-body">
                            <h6 class="card-title">Data Export</h6>
                            <p class="card-text">Export system data</p>
                            <button class="btn btn-info btn-sm" @onclick='() => NavigateTo("/admin/export")'>
                                <i class="bi bi-download"></i> Export Data
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-info">
                        <div class="card-body">
                            <h6 class="card-title">Data Archival</h6>
                            <p class="card-text">Configure archival rules</p>
                            <button class="btn btn-info btn-sm" @onclick='() => NavigateTo("/admin/archival")'>
                                <i class="bi bi-archive"></i> Configure
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-info">
                        <div class="card-body">
                            <h6 class="card-title">Backup Configuration</h6>
                            <p class="card-text">Schedule and manage backups</p>
                            <button class="btn btn-info btn-sm" @onclick='() => NavigateTo("/admin/backup")'>
                                <i class="bi bi-hdd"></i> Configure
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- User Management -->
    <div class="card">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0"><i class="bi bi-people"></i> User Management</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card h-100 border-warning">
                        <div class="card-body">
                            <h6 class="card-title">Manage Users</h6>
                            <p class="card-text">Create, edit, and deactivate users</p>
                            <button class="btn btn-warning btn-sm" @onclick='() => NavigateTo("/admin/users")'>
                                <i class="bi bi-person-gear"></i> Manage
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-warning">
                        <div class="card-body">
                            <h6 class="card-title">Roles & Permissions</h6>
                            <p class="card-text">Configure user roles and access</p>
                            <button class="btn btn-warning btn-sm" @onclick='() => NavigateTo("/admin/roles")'>
                                <i class="bi bi-shield-check"></i> Configure
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-warning">
                        <div class="card-body">
                            <h6 class="card-title">Audit Log</h6>
                            <p class="card-text">View system audit trail</p>
                            <button class="btn btn-warning btn-sm" @onclick='() => NavigateTo("/admin/audit-log")'>
                                <i class="bi bi-clock-history"></i> View Log
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private void NavigateTo(string path)
    {
        Navigation.NavigateTo(path);
    }
}
